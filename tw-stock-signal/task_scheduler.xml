<?xml version="1.0" encoding="UTF-16"?>
<!--
  Windows Task Scheduler definition for tw-stock-signal.

  HOW TO IMPORT:
    1. Open "Task Scheduler" (taskschd.msc)
    2. Action → Import Task...
    3. Select this file (task_scheduler.xml)
    4. Edit the <UserId> field to your Windows username
    5. Click OK and enter your Windows password when prompted

  WHAT IT DOES:
    - Triggers at Windows logon (not system startup, so no service needed)
    - Runs start.bat which activates venv and starts the daemon scheduler
    - The scheduler itself handles the 06:55 / 07:00 / 07:30 / 07:55 / 08:00 jobs
    - Restarts automatically if it crashes (up to 3 times, 1 minute apart)
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>台股 ABC 選股訊號 — 盤前自動排程</Description>
    <URI>\tw-stock-signal</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <!-- Remove the <UserId> tag to trigger for ALL users, or specify one user -->
      <UserId>sfudally</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>  <!-- No time limit (daemon runs forever) -->
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>    <!-- Restart after 1 minute -->
      <Count>3</Count>             <!-- Up to 3 restarts -->
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\sfudally\Desktop\code test\tw-stock-signal\start.bat</Command>
      <WorkingDirectory>C:\Users\sfudally\Desktop\code test\tw-stock-signal</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
