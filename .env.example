# Trading Terminal — environment variables
# Copy this file to `.env.local` and fill in the values. NEVER commit `.env.local`.

# Telegram bot (Phase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Market data providers (Phase 3)
# 申請：https://finmindtrade.com → 個人頁面 → API Token
FINMIND_API_TOKEN=
# Legacy alias (still accepted for back-compat); only set ONE of the two:
# FINMIND_TOKEN=

# Gemini (Phase 7 — C 軸 AI 自動判定)
# 申請：https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Real-time tick feeder (Phase 9)
# 對應 python-feeder/main.py 啟動的位置；含 ws:// 前綴，無尾斜線
NEXT_PUBLIC_TICK_WS_URL=ws://localhost:8000

TWSE_API_BASE=https://openapi.twse.com.tw
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
