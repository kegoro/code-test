# ============================================================
#  .env.example  →  複製為 .env 並填入你的 API 金鑰
# ============================================================

# ── Telegram ─────────────────────────────────────────────────
# 1. 找 @BotFather 建立 bot，取得 token
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. 找 @userinfobot 取得你的 chat id
TELEGRAM_CHAT_ID=123456789

# ── Anthropic Claude ─────────────────────────────────────────
# https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── TradingView（可選，登入後可用自訂指標）─────────────────────
TV_USERNAME=
TV_PASSWORD=

# ── Telegraph（HTML 報告上傳，可選）───────────────────────────
TELEGRAPH_TOKEN=
